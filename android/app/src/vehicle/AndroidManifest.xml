<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />
    <!-- Pleos API 34 exposes android.car on BOOTCLASSPATH via its Car APEX.
         Other AAOS images expose the named shared library. Require Automotive
         hardware, load the library when available, and check APIs at runtime. -->
    <application><uses-library android:name="android.car" android:required="false" tools:replace="android:required" /></application>
</manifest>
